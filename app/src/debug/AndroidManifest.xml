<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only additions. The Analyzer Lab's launcher entry lives here so that a release build
  gains no second launcher icon and no evidence tooling. The INTERNET permission moved to the
  main manifest in STAGE-024, when project import became a product feature.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".analyzer.lab.AnalyzerLabActivity"
            android:exported="true"
            android:label="@string/lab_launcher_label"
            android:theme="@style/Theme.BuildPlan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
